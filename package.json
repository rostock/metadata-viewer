{
  "name": "@gdmhro/metadata-viewer",
  "version": "1.0.6",
  "description": "",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "prepublishOnly": "vcmplugin build",
    "build": "vcmplugin build",
    "bundle": "vcmplugin bundle",
    "start": "vcmplugin serve",
    "preview": "vcmplugin preview",
    "buildStagingApp": "vcmplugin buildStagingApp",
    "lint:js": "eslint . --ext .vue,.js,.cjs,.mjs,.ts,.cts,.mts",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "format": "prettier --write --list-different . && npm run lint:js -- --fix",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "author": "author <email>",
  "license": "MIT",
  "keywords": [
    "vcmap",
    "plugin"
  ],
  "files": [
    "src/",
    "dist/",
    "plugin-assets/",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "src/index.js",
    "./dist": "./dist/index.js"
  },
  "eslintIgnore": [
    "node_modules",
    "dist",
    "plugin-assets"
  ],
  "prettier": "@vcsuite/eslint-config/prettier.js",
  "peerDependencies": {
    "@vcmap-cesium/engine": "^11.0.3",
    "@vcmap/core": "^6.2.3",
    "@vcmap/ui": "^6.2.3",
    "ol": "^10.7.0",
    "vue": "~3.4.38",
    "vuetify": "~3.7.14"
  },
  "devDependencies": {
    "@vcmap/plugin-cli": "^4.1.3",
    "@vcsuite/eslint-config": "^4.1.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jest-canvas-mock": "^2.5.2",
    "jsdom": "^27.1.0",
    "resize-observer-polyfill": "^1.5.1",
    "vitest": "^2.1.9"
  },
  "mapVersion": "^6.2",
  "overrides": {
    "esbuild": "^0.25.0",
    "@zip.js/zip.js": "2.7.73"
  }
}
